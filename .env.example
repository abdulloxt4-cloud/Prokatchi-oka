# LOCAL: cp .env.example .env (do not upload .env to GitHub)
FLASK_DEBUG=0
# Render + Neon: postgresql://...?...sslmode=require
DATABASE_URL=
# Create Telegram bot via @BotFather, keep token secret (never in public code)
TELEGRAM_BOT_TOKEN=
# Send /start to bot, discover your numeric chat ID using getUpdates; do not paste secrets in public chat.
TELEGRAM_CHAT_ID=

# Optional: the second Telegram recipient (must start the bot first)
TELEGRAM_CHAT_ID_2=

# Optional: additional allowed Render Static Site origin while testing before domain migration
FRONTEND_ORIGIN=
# For NEW Render Static Site only. Set to the HTTPS URL of EXISTING Python backend.
# PROKATCHI_API_URL is not a secret. Never put DATABASE_URL or bot token here.
PROKATCHI_API_URL=
